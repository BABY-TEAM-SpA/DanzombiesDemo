  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4d72983f531c2934788a8b5daad13a3f, type: 3}
  m_Name: DialogData_Tutorial3_1
  m_EditorClassIdentifier: Assembly-CSharp::DialogDataSO
  dialogs:
  - profile: {fileID: 21300000, guid: 5bd8b00560d177d4eb7e562475a7442c, type: 3}
    Character: Steph
    texts:
    - language: 0
      text: "\xA1Ja, ja! \xA1Est\xE1s vivo! \xA1Viste que pod\xEDas bailar!"
  - profile: {fileID: 21300000, guid: 98e98bdd8e6df0b49aa718e67b45b96e, type: 3}
    Character: Greg
    texts:
    - language: 0
      text: '*huf* Por favor no me vuelvas a dejar solo'
  - profile: {fileID: 21300000, guid: 5bd8b00560d177d4eb7e562475a7442c, type: 3}
    Character: Steph
    texts:
    - language: 0
      text: " Pero si estoy aqu\xED contigo. Te dije que te iba a ense\xF1ar a bailar!"
  - profile: {fileID: 21300000, guid: 98e98bdd8e6df0b49aa718e67b45b96e, type: 3}
    Character: Greg
    texts:
    - language: 0
      text: "Pero no s\xE9 hacer otro paso de baile m\xE1s que el que me ense\xF1aste
        en la tienda! "
  - profile: {fileID: 21300000, guid: 98e98bdd8e6df0b49aa718e67b45b96e, type: 3}
    Character: Greg
    texts:
    - language: 0
      text: "Y mira!, esos zombies est\xE1n haciendo otro totalmente distinto."
  - profile: {fileID: 21300000, guid: 5bd8b00560d177d4eb7e562475a7442c, type: 3}
    Character: Steph
    texts:
    - language: 0
      text: " No es tan dif\xEDcil, solo tienes que imitarlos!"
  - profile: {fileID: 21300000, guid: 5bd8b00560d177d4eb7e562475a7442c, type: 3}
    Character: Steph
    texts:
    - language: 0
      text: "Practiquemos aqu\xED primero para que puedas pasar. "
  - profile: {fileID: 21300000, guid: 5bd8b00560d177d4eb7e562475a7442c, type: 3}
    Character: Steph
    texts:
    - language: 0
      text: "\xBFListo? \xA1Empecemos con todo! \xA1hacia ambos lados! "
